{
  "name": "DeckWarden",
  "version": "0.6.3",
  "description": "DeckWarden is a Decky Plugin to access your self-hosted Vaultwarden (Bitwarden) vault directly in SteamOS gaming mode. Based on DeckPass.",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "test": "echo \"Error: no test specified\" && exit 1",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,scss,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,scss,md}\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nithou/deckwarden.git"
  },
  "keywords": [
    "decky",
    "steam-deck",
    "deck",
    "password",
    "password-manager",
    "bitwarden",
    "vaultwarden",
    "utility"
  ],
  "author": "nithou",
  "license": "GPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/nithou/deckwarden/issues"
  },
  "homepage": "https://github.com/nithou/deckwarden#readme",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.1",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@types/webpack": "^5.28.5",
    "prettier": "^3.2.5",
    "rollup": "^4.55.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.5.0",
    "tslib": "^2.8.1"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
